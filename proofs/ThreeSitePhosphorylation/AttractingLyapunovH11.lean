theorem h11_residual_identity (r w : ℝ) (i : Fin 9) :
    (even1 (w^2) : ℂ) *
      (((sourceMatrix r).map (algebraMap ℝ ℂ)).mulVec
        (fun j => (lyapunovH11 (w^2) j : ℂ)) i -
        complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
          (fun j => star (adjugateVector (Complex.I*(w:ℂ)) j)) i) =
      (frequencyPolynomial (w^2) : ℂ) * (h11ModulusQuotient (w^2) i : ℂ) +
      ((even0 (w^2)+r*even1 (w^2) : ℝ) : ℂ) *
        (h11ParameterCoefficient (w^2) i : ℂ) := by
  fin_cases i <;> apply Complex.ext <;>
    simp [sourceMatrix,lyapunovH11,h11ModulusQuotient,h11ParameterCoefficient,
      even0,even1,frequencyPolynomial,complexHessian,complexHessianRow,
      complexSpecies,binding,inputSpecies,enzymeSpecies,adjugateVector,
      Matrix.mulVec,dotProduct,Fin.sum_univ_succ,pow_succ,
      Complex.mul_re,Complex.mul_im]
  all_goals ring_nf
  all_goals simp

theorem source_h11_resolvent (r w : ℝ)
    (hf : frequencyPolynomial (w^2)=0)
    (hp : even0 (w^2)+r*even1 (w^2)=0)
    (he : even1 (w^2) ≠ 0) :
    ((sourceMatrix r).map (algebraMap ℝ ℂ)).mulVec
      (fun j => (lyapunovH11 (w^2) j : ℂ)) =
      complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
        (fun j => star (adjugateVector (Complex.I*(w:ℂ)) j)) := by
  ext i
  have h := h11_residual_identity r w i
  have hz : (even1 (w^2) : ℂ) *
      (((sourceMatrix r).map (algebraMap ℝ ℂ)).mulVec
        (fun j => (lyapunovH11 (w^2) j : ℂ)) i -
        complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
          (fun j => star (adjugateVector (Complex.I*(w:ℂ)) j)) i) = 0 := by
    simpa [hf,hp] using h
  have hec : (even1 (w^2) : ℂ) ≠ 0 := by exact_mod_cast he
  exact sub_eq_zero.mp ((mul_eq_zero.mp hz).resolve_left hec)

end
