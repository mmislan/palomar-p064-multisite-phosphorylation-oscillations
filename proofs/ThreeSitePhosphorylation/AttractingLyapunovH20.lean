def h20RealMultiplier : Fin 9 → ℝ :=
  ![(),
    (-),
    (-),
    (),
    (),
    (-),
    (0),
    (),
    (-)]

def h20ImagQuotient (t : ℝ) : ℝ :=
  ()*t^3 + (-)*t^2 + (-)*t^1 + (-)*t^0

def h20ImagParameter (t : ℝ) : ℝ :=
  ()*t^7 + (-)*t^6 + ()*t^5 + (-)*t^4 + ()*t^3 + (-)*t^2 + ()*t^1 + (-)*t^0

def h20Pair (w : ℝ) (x y : ReducedState) : Fin 9 → ℂ :=
  (fun i => (x i : ℂ)) + (Complex.I*(w:ℂ)) • (fun i => (y i : ℂ))

theorem h20_q_pair (w : ℝ) :
    adjugateVector (Complex.I*(w:ℂ)) = h20Pair w (h20QReal (w^2)) (h20QImag (w^2)) := by
  ext i
  fin_cases i <;> apply Complex.ext <;>
    simp [h20Pair,h20QReal,h20QImag,adjugateVector,pow_succ,Complex.mul_re,Complex.mul_im]
  all_goals ring

theorem h20_hessian_pair_re (r w : ℝ) (x y : ReducedState) (i : Fin 9) :
    (complexHessian r (h20Pair w x y) (h20Pair w x y) i).re =
      hessian r x x i - w^2*hessian r y y i := by
  simp only [h20Pair,complexHessian_add_left,complexHessian_add_right,
    complexHessian_smul_left,complexHessian_smul_right,complexHessian_ofReal,
    Pi.add_apply,Pi.smul_apply,smul_eq_mul]
  simp [Complex.mul_re,Complex.mul_im]
  ring

theorem h20_hessian_pair_im (r w : ℝ) (x y : ReducedState) (i : Fin 9) :
    (complexHessian r (h20Pair w x y) (h20Pair w x y) i).im =
      w*(2*hessian r x y i) := by
  simp only [h20Pair,complexHessian_add_left,complexHessian_add_right,
    complexHessian_smul_left,complexHessian_smul_right,complexHessian_ofReal,
    Pi.add_apply,Pi.smul_apply,smul_eq_mul]
  simp [Complex.mul_re,Complex.mul_im,hessian_symmetric r y x]
  ring

theorem h20_real_residual_off_six (r t : ℝ) (i : Fin 9) (hi : i ≠ 6) :
    -2*t*h20ImagInt t i - (sourceMatrix r).mulVec (h20RealInt t) i -
      h20Scale*(hessian r (h20QReal t) (h20QReal t) i -
        t*hessian r (h20QImag t) (h20QImag t) i) =
    frequencyPolynomial t*h20RealMultiplier i := by
  fin_cases i
  all_goals try contradiction
  all_goals simp [h20RealInt,h20ImagInt,h20Scale,h20QReal,h20QImag,
    sourceMatrix,Matrix.mulVec,dotProduct,Fin.sum_univ_succ,hessian,hessianRow,
    speciesVariation,coordinate,binding,inputSpecies,enzymeSpecies,
    frequencyPolynomial,h20RealMultiplier]
  all_goals ring

theorem h20_imag_residual_off_six (r t : ℝ) (i : Fin 9) (hi : i ≠ 6) :
    2*h20RealInt t i - (sourceMatrix r).mulVec (h20ImagInt t) i -
      h20Scale*(2*hessian r (h20QReal t) (h20QImag t) i) = 0 := by
  fin_cases i
  all_goals try contradiction
  all_goals simp [h20RealInt,h20ImagInt,h20Scale,h20QReal,h20QImag,
    sourceMatrix,Matrix.mulVec,dotProduct,Fin.sum_univ_succ,hessian,hessianRow,
    speciesVariation,coordinate,binding,inputSpecies,enzymeSpecies]
  all_goals ring

theorem h20_imag_residual_six (r t : ℝ) :
    even1 t*(2*h20RealInt t 6 - (sourceMatrix r).mulVec (h20ImagInt t) 6 -
      h20Scale*(2*hessian r (h20QReal t) (h20QImag t) 6)) =
    frequencyPolynomial t*h20ImagQuotient t +
      (even0 t+r*even1 t)*h20ImagParameter t := by
  simp [h20RealInt,h20ImagInt,h20Scale,h20QReal,h20QImag,
    sourceMatrix,Matrix.mulVec,dotProduct,Fin.sum_univ_succ,hessian,hessianRow,
    speciesVariation,coordinate,binding,inputSpecies,enzymeSpecies,
    frequencyPolynomial,even0,even1,h20ImagQuotient,h20ImagParameter]
  ring

theorem h20_action_re (r w : ℝ) (i : Fin 9) :
    (secondHarmonic r w (scaledH20 w) i).re =
      -2*w^2*h20ImagInt (w^2) i -
        (sourceMatrix r).mulVec (h20RealInt (w^2)) i := by
  fin_cases i <;>
    simp [secondHarmonic,scaledH20,complexSource,sourceMatrix,Matrix.mulVec,
      dotProduct,Fin.sum_univ_succ,Complex.mul_re,Complex.mul_im]
  all_goals ring

theorem h20_action_im (r w : ℝ) (i : Fin 9) :
    (secondHarmonic r w (scaledH20 w) i).im =
      w*(2*h20RealInt (w^2) i -
        (sourceMatrix r).mulVec (h20ImagInt (w^2)) i) := by
  fin_cases i <;>
    simp [secondHarmonic,scaledH20,complexSource,sourceMatrix,Matrix.mulVec,
      dotProduct,Fin.sum_univ_succ,Complex.mul_re,Complex.mul_im]
  all_goals ring

theorem source_scaled_h20_resolvent (r w : ℝ)
    (hf : frequencyPolynomial (w^2)=0)
    (hp : even0 (w^2)+r*even1 (w^2)=0)
    (he : even1 (w^2) ≠ 0) :
    secondHarmonic r w (scaledH20 w) = (h20Scale:ℂ) •
      complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
        (adjugateVector (Complex.I*(w:ℂ))) := by
  ext i
  apply Complex.ext
  · simp only [Pi.smul_apply,smul_eq_mul,Complex.mul_re,Complex.ofReal_re,
      Complex.ofReal_im,zero_mul,sub_zero]
    by_cases hi : i = 6
    · subst i
      exact source_scaled_h20_real_row6 r w hf hp he
    have h := h20_real_residual_off_six r (w^2) i hi
    rw [hf,zero_mul] at h
    rw [h20_action_re,h20_q_pair,h20_hessian_pair_re]
    linear_combination h
  · simp only [Pi.smul_apply,smul_eq_mul,Complex.mul_im,Complex.ofReal_re,
      Complex.ofReal_im,zero_mul,add_zero]
    have h : 2*h20RealInt (w^2) i -
        (sourceMatrix r).mulVec (h20ImagInt (w^2)) i -
        h20Scale*(2*hessian r (h20QReal (w^2)) (h20QImag (w^2)) i) = 0 := by
      by_cases hi : i = 6
      · subst i
        have h := h20_imag_residual_six r (w^2)
        rw [hf,hp] at h
        exact (mul_eq_zero.mp (by simpa using h)).resolve_left he
      · exact h20_imag_residual_off_six r (w^2) i hi
    rw [h20_action_im,h20_q_pair,h20_hessian_pair_im]
    linear_combination w*h

theorem source_h20_resolvent (r w : ℝ)
    (hf : frequencyPolynomial (w^2)=0)
    (hp : even0 (w^2)+r*even1 (w^2)=0)
    (he : even1 (w^2) ≠ 0) :
    secondHarmonic r w (h20Pilot w) =
      complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
        (adjugateVector (Complex.I*(w:ℂ))) := by
  have hk : (h20Scale:ℂ) ≠ 0 := by exact_mod_cast ne_of_gt h20Scale_pos
  rw [h20Pilot,map_smul,source_scaled_h20_resolvent r w hf hp he,
    smul_smul,inv_mul_cancel₀ hk,one_smul]

end
end ThreeSitePhosphorylation.AttractingWitness
