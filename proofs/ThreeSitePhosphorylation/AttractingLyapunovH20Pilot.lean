import proofs.ThreeSitePhosphorylation.AttractingJet
import proofs.ThreeSitePhosphorylation.AttractingResolvent

/-! A single representative h20 certificate: only real row 6 is proved. -/
namespace ThreeSitePhosphorylation.AttractingWitness
noncomputable section
set_option maxRecDepth 10000
set_option maxHeartbeats 0

def h20Scale : ℝ := 

theorem h20Scale_pos : 0 < h20Scale := by norm_num [h20Scale]

def h20RealInt (t : ℝ) : Fin 9 → ℝ :=
  ![(-)*t^7 + ()*t^6 + (-)*t^5 + ()*t^4 + (-)*t^3 + (-)*t^2 + ()*t^1 + ()*t^0,
    ()*t^7 + ()*t^6 + (-)*t^5 + ()*t^4 + ()*t^3 + ()*t^2 + (-)*t^1 + (-)*t^0,
    ()*t^7 + ()*t^6 + (-)*t^5 + ()*t^4 + (-)*t^3 + ()*t^2 + (-)*t^1 + (-)*t^0,
    (-)*t^7 + (-)*t^6 + ()*t^5 + (-)*t^4 + ()*t^3 + (-)*t^2 + ()*t^1 + ()*t^0,
    (-)*t^7 + ()*t^6 + (-)*t^5 + (-)*t^4 + (-)*t^3 + (-)*t^2 + ()*t^1 + ()*t^0,
    (-)*t^7 + ()*t^6 + (-)*t^5 + ()*t^4 + ()*t^3 + ()*t^2 + (-)*t^1 + (-)*t^0,
    ()*t^7 + (-)*t^6 + ()*t^5 + (-)*t^4 + ()*t^3 + ()*t^2 + (-)*t^1 + ()*t^0,
    ()*t^7 + (-)*t^6 + ()*t^5 + (-)*t^4 + (-)*t^3 + (-)*t^2 + ()*t^1 + ()*t^0,
    (-)*t^7 + ()*t^6 + (-)*t^5 + (-)*t^4 + ()*t^3 + (-)*t^2 + (-)*t^1 + (-)*t^0]

def h20ImagInt (t : ℝ) : Fin 9 → ℝ :=
  ![(-)*t^7 + (-)*t^6 + (-)*t^5 + (-)*t^4 + (-)*t^3 + (-)*t^2 + (-)*t^1 + ()*t^0,
    ()*t^7 + ()*t^6 + (-)*t^5 + ()*t^4 + ()*t^3 + ()*t^2 + (-)*t^1 + (-)*t^0,
    ()*t^7 + ()*t^6 + ()*t^5 + ()*t^4 + ()*t^3 + ()*t^2 + (-)*t^1 + (-)*t^0,
    (-)*t^7 + (-)*t^6 + (-)*t^5 + (-)*t^4 + (-)*t^3 + (-)*t^2 + ()*t^1 + ()*t^0,
    (-)*t^7 + (-)*t^6 + (-)*t^5 + (-)*t^4 + (-)*t^3 + (-)*t^2 + ()*t^1 + ()*t^0,
    ()*t^7 + ()*t^6 + (-)*t^5 + ()*t^4 + ()*t^3 + ()*t^2 + (-)*t^1 + (-)*t^0,
    ()*t^7 + (-)*t^6 + ()*t^5 + (-)*t^4 + ()*t^3 + (-)*t^2 + (-)*t^1 + ()*t^0,
    (-)*t^7 + (-)*t^6 + ()*t^5 + (-)*t^4 + (-)*t^3 + (-)*t^2 + ()*t^1 + ()*t^0,
    ()*t^7 + ()*t^6 + (-)*t^5 + ()*t^4 + ()*t^3 + ()*t^2 + ()*t^1 + (-)*t^0]

def h20SpeciesReal (t : ℝ) : ℝ :=
  (-1)*t^4 + (2481157039816613/485622000000)*t^3 + (-13506847755095042333413/27923265000000000)*t^2 + (40995702190145261764847/96955781250000000)*t^1 + (-622427658415749856/252489013671875)*t^0

def h20SpeciesImag (t : ℝ) : ℝ :=
  (863769773/7038000)*t^3 + (-1571919809733148733/18615510000000)*t^2 + (132929674014406813883/146625000000000)*t^1 + (-1159958441709764229/17564453125000)*t^0

def h20EnzymeReal (t : ℝ) : ℝ :=
  (-1)*t^4 + (1803668764320127/485622000000)*t^3 + (-228027503342535225673/1138176562500000)*t^2 + (96249339447496742272027/872602031250000000)*t^1 + (-1912211342666914348/3787335205078125)*t^0

def h20EnzymeImag (t : ℝ) : ℝ :=
  (732471089/7038000)*t^3 + (-18559293676186902287/364216500000000)*t^2 + (1416909497369535734400127/5235612187500000000)*t^1 + (-353667620203627717757/22724011230468750)*t^0

def h20Row6Quotient (t : ℝ) : ℝ :=
  (-)*t^4 + ()*t^3 + (-)*t^2 + (-)*t^1

def h20Row6Parameter (t : ℝ) : ℝ :=
  (-)*t^8 + ()*t^7 + (-)*t^6 + ()*t^5 + (-)*t^4 + ()*t^3 + (-)*t^2 + (-)*t^1 + (-)*t^0

theorem h20_species_pair (w : ℝ) :
    (complexSpecies (adjugateVector (Complex.I*(w:ℂ))) 1).re = h20SpeciesReal (w^2) ∧
    (complexSpecies (adjugateVector (Complex.I*(w:ℂ))) 1).im = w*h20SpeciesImag (w^2) ∧
    (complexSpecies (adjugateVector (Complex.I*(w:ℂ))) 5).re = h20EnzymeReal (w^2) ∧
    (complexSpecies (adjugateVector (Complex.I*(w:ℂ))) 5).im = w*h20EnzymeImag (w^2) := by
  constructor
  · simp [complexSpecies,adjugateVector,h20SpeciesReal,pow_succ,Complex.mul_re,Complex.mul_im]
    ring
  constructor
  · simp [complexSpecies,adjugateVector,h20SpeciesImag,pow_succ,Complex.mul_re,Complex.mul_im]
    ring
  constructor
  · simp [complexSpecies,adjugateVector,h20EnzymeReal,pow_succ,Complex.mul_re,Complex.mul_im]
    ring
  · simp [complexSpecies,adjugateVector,h20EnzymeImag,pow_succ,Complex.mul_re,Complex.mul_im]
    ring

theorem h20_hessian_real (r w : ℝ) :
    (complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
      (adjugateVector (Complex.I*(w:ℂ))) 6).re =
    (1+r)/24*(h20SpeciesReal (w^2)*h20EnzymeReal (w^2) -
      w^2*h20SpeciesImag (w^2)*h20EnzymeImag (w^2)) := by
  obtain ⟨hsr,hsi,her,hei⟩ := h20_species_pair w
  simp [complexHessian,complexHessianRow,binding,inputSpecies,enzymeSpecies,
    Complex.mul_re,Complex.mul_im,hsr,hsi,her,hei]
  ring

theorem h20_row6_identity (r t : ℝ) :
    even1 t*(-2*t*h20ImagInt t 6 - (sourceMatrix r).mulVec (h20RealInt t) 6 -
      h20Scale*((1+r)/24)*(h20SpeciesReal t*h20EnzymeReal t -
        t*h20SpeciesImag t*h20EnzymeImag t)) =
    frequencyPolynomial t*h20Row6Quotient t +
      (even0 t+r*even1 t)*h20Row6Parameter t := by
  simp [even1,even0,frequencyPolynomial,h20Row6Quotient,h20Row6Parameter,
    h20Scale,h20RealInt,h20ImagInt,h20SpeciesReal,h20SpeciesImag,
    h20EnzymeReal,h20EnzymeImag,sourceMatrix,Matrix.mulVec,dotProduct,Fin.sum_univ_succ]
  ring

def scaledH20 (w : ℝ) : Fin 9 → ℂ :=
  fun i => (h20RealInt (w^2) i : ℂ) + Complex.I*(w:ℂ)*(h20ImagInt (w^2) i : ℂ)

theorem h20_action_real (r w : ℝ) :
    (secondHarmonic r w (scaledH20 w) 6).re =
      -2*w^2*h20ImagInt (w^2) 6 -
        (sourceMatrix r).mulVec (h20RealInt (w^2)) 6 := by
  simp [secondHarmonic,scaledH20,complexSource,sourceMatrix,Matrix.mulVec,
    dotProduct,Fin.sum_univ_succ,Complex.mul_re,Complex.mul_im]
  ring

theorem source_scaled_h20_real_row6 (r w : ℝ)
    (hf : frequencyPolynomial (w^2)=0)
    (hp : even0 (w^2)+r*even1 (w^2)=0)
    (he : even1 (w^2) ≠ 0) :
    (secondHarmonic r w (scaledH20 w) 6).re = h20Scale*
      (complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
        (adjugateVector (Complex.I*(w:ℂ))) 6).re := by
  have hi := h20_row6_identity r (w^2)
  rw [hf,hp] at hi
  have hz : -2*w^2*h20ImagInt (w^2) 6 -
      (sourceMatrix r).mulVec (h20RealInt (w^2)) 6 -
      h20Scale*((1+r)/24)*(h20SpeciesReal (w^2)*h20EnzymeReal (w^2) -
        w^2*h20SpeciesImag (w^2)*h20EnzymeImag (w^2)) = 0 :=
    (mul_eq_zero.mp (by simpa using hi)).resolve_left he
  rw [h20_action_real,h20_hessian_real]
  linear_combination hz

def h20Pilot (w : ℝ) : Fin 9 → ℂ := (h20Scale:ℂ)⁻¹ • scaledH20 w

theorem source_h20_real_row6 (r w : ℝ)
    (hf : frequencyPolynomial (w^2)=0)
    (hp : even0 (w^2)+r*even1 (w^2)=0)
    (he : even1 (w^2) ≠ 0) :
    (secondHarmonic r w (h20Pilot w) 6).re =
      (complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
        (adjugateVector (Complex.I*(w:ℂ))) 6).re := by
  have hk : h20Scale ≠ 0 := ne_of_gt h20Scale_pos
  have hi := source_scaled_h20_real_row6 r w hf hp he
  simp only [h20Pilot,map_smul,Pi.smul_apply,smul_eq_mul]
  rw [← Complex.ofReal_inv]
  simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
  rw [hi,← mul_assoc,inv_mul_cancel₀ hk,one_mul]

end
end ThreeSitePhosphorylation.AttractingWitness
