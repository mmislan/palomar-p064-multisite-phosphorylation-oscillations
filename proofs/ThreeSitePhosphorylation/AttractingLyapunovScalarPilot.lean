import proofs.ThreeSitePhosphorylation.AttractingLyapunovH20Pilot
import proofs.ThreeSitePhosphorylation.AttractingLyapunovSign

/-! A representative scalar cross identity. These coefficient polynomials
must still be identified with the actual source contraction in Lean.
This file alone proves neither the source G21 sign nor attraction. -/
namespace ThreeSitePhosphorylation.AttractingWitness
noncomputable section
set_option maxRecDepth 10000
set_option maxHeartbeats 0

def lyapunovScalarRe (t : ℝ) : ℝ :=
  ()*t^19 + (-)*t^18 + ()*t^17 + ()*t^16 + (-)*t^15 + (-)*t^14 + ()*t^13 + (-)*t^12 + (-)*t^11 + ()*t^10 + ()*t^9 + (-)*t^8 + ()*t^7 + ()*t^6 + (-)*t^5 + (-)*t^4 + ()*t^3 + (-)*t^2 + (-)*t^1

def lyapunovScalarIm (t : ℝ) : ℝ :=
  ()*t^19 + (-)*t^18 + ()*t^17 + ()*t^16 + (-)*t^15 + (-)*t^14 + ()*t^13 + (-)*t^12 + ()*t^11 + ()*t^10 + ()*t^9 + (-)*t^8 + ()*t^7 + ()*t^6 + ()*t^5 + (-)*t^4 + (-)*t^3 + (-)*t^2 + ()*t^1 + ()*t^0

def lyapunovPairingRe (t : ℝ) : ℝ :=
  (-145/552)*t^8 + (706065861490784782361/136712305440000000)*t^7 + (-564291245117141309056601091719041/72320809577760000000000000)*t^6 + (164431678402433608197884591299919438401861/122041366162470000000000000000000)*t^5 + (-4355549569535497137484965287955022607731367371/152551707703087500000000000000000000)*t^4 + (261331343605236485946337609531094712415706016391/3531289530164062500000000000000000000)*t^3 + (-157147360127209401829723639545226362501616819/16552919672644042968750000000000000)*t^2 + (-61550746443195034462944078173798247071219/574754155300140380859375000000000)*t^1 + (4768770897113492996902621415394764/24945926879346370697021484375)*t^0

def lyapunovPairingIm (t : ℝ) : ℝ :=
  (535682119897/9712440000)*t^7 + (-1246247605348936894022751449/4716574537680000000000)*t^6 + (2738059823193613024557181229415683609/20340227693745000000000000000)*t^5 + (-8007125591321547917363292273172211946504599/1017011384687250000000000000000000)*t^4 + (6578466500530225655476890356088338665286720329/105938685904921875000000000000000000)*t^3 + (-163021533167659090402441404868630262467074393409/3972700721434570312500000000000000000)*t^2 + (31546683960994885079354416611834382536131/67618135917663574218750000000000)*t^1 + (29088673899654630196694936729183198651/2993511225521564483642578125000)*t^0

def lyapunovCrossQuotient (t : ℝ) : ℝ :=
  (-)*t^55 + (-)*t^54 + (-)*t^53 + (-)*t^52 + ()*t^51 + (-)*t^50 + ()*t^49 + ()*t^48 + (-)*t^47 + (-)*t^46 + (-)*t^45 + (-)*t^44 + (-)*t^43 + (-)*t^42 + (-)*t^41 + (-)*t^40 + (-)*t^39 + (-)*t^38 + ()*t^37 + (-)*t^36 + (-)*t^35 + ()*t^34 + (-)*t^33 + ()*t^32 + (-)*t^31 + ()*t^30 + ()*t^29 + (-)*t^28 + (-)*t^27 + (-)*t^26 + ()*t^25 + ()*t^24 + (-)*t^23 + (-)*t^22 + ()*t^21 + (-)*t^20 + (-)*t^19 + ()*t^18 + (-)*t^17 + (-)*t^16 + (-)*t^15 + (-)*t^14 + ()*t^13 + ()*t^12 + (-)*t^11 + (-)*t^10 + ()*t^9 + ()*t^8 + ()*t^7 + (-)*t^6 + (-)*t^5 + ()*t^4 + ()*t^3 + ()*t^2 + ()*t^1

def lyapunovDirectNumerator (t : ℝ) : ℝ :=
  lyapunovScalarRe t*lyapunovPairingRe t +
    t*lyapunovScalarIm t*lyapunovPairingIm t

def lyapunovDirectDenominator (t : ℝ) : ℝ :=
  h20Scale*even1 t*(lyapunovPairingRe t^2 + t*lyapunovPairingIm t^2)

theorem lyapunov_scalar_cross_identity (t : ℝ) :
    lyapunovDirectNumerator t*lyapunovDenominator t -
      lyapunovDirectDenominator t*lyapunovNumerator t =
    frequencyPolynomial t*lyapunovCrossQuotient t := by
  unfold lyapunovDirectNumerator lyapunovDirectDenominator lyapunovScalarRe
    lyapunovScalarIm lyapunovPairingRe lyapunovPairingIm h20Scale even1
    lyapunovDenominator lyapunovNumerator frequencyPolynomial lyapunovCrossQuotient
  ring

end
end ThreeSitePhosphorylation.AttractingWitness
