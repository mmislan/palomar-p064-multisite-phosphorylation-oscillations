def evalIntCoeffs : List ℤ → ℝ → ℝ
  | [], _ => 0
  | a :: cs, u => (a : ℝ) + u * evalIntCoeffs cs u

def coeffMass : List ℤ → ℤ
  | [] => 0
  | a :: cs => |a| + coeffMass cs

theorem evalIntCoeffs_bound (cs : List ℤ) (u : ℝ) (hu : |u| ≤ 1) :
    |evalIntCoeffs cs u| ≤ (coeffMass cs : ℝ) := by
  induction cs with
  | nil => simp [evalIntCoeffs, coeffMass]
  | cons a cs ih =>
    have hp : |u * evalIntCoeffs cs u| ≤ (coeffMass cs : ℝ) := by
      rw [abs_mul]
      calc
        _ ≤ 1 * (coeffMass cs : ℝ) := mul_le_mul hu ih (abs_nonneg _) zero_le_one
        _ = _ := one_mul _
    calc
      _ ≤ |(a : ℝ)| + |u * evalIntCoeffs cs u| := abs_add_le _ _
      _ ≤ |(a : ℝ)| + (coeffMass cs : ℝ) := add_le_add le_rfl hp
      _ = (coeffMass (a :: cs) : ℝ) := by simp [coeffMass]

theorem evalIntCoeffs_negative (a : ℤ) (cs : List ℤ) (u : ℝ) (hu : |u| ≤ 1)
    (ha : a + coeffMass cs < 0) : evalIntCoeffs (a :: cs) u < 0 := by
  have hb := evalIntCoeffs_bound cs u hu
  have hp : |u * evalIntCoeffs cs u| ≤ (coeffMass cs : ℝ) := by
    rw [abs_mul]
    simpa using mul_le_mul hu hb (abs_nonneg (evalIntCoeffs cs u)) zero_le_one
  have hn : (a : ℝ) + (coeffMass cs : ℝ) < 0 := by exact_mod_cast ha
  change (a : ℝ) + u * evalIntCoeffs cs u < 0
  linarith [(abs_le.mp hp).2]

theorem evalIntCoeffs_positive (a : ℤ) (cs : List ℤ) (u : ℝ) (hu : |u| ≤ 1)
    (ha : 0 < a - coeffMass cs) : 0 < evalIntCoeffs (a :: cs) u := by
  have hb := evalIntCoeffs_bound cs u hu
  have hp : |u * evalIntCoeffs cs u| ≤ (coeffMass cs : ℝ) := by
    rw [abs_mul]
    simpa using mul_le_mul hu hb (abs_nonneg (evalIntCoeffs cs u)) zero_le_one
  have hn : 0 < (a : ℝ) - (coeffMass cs : ℝ) := by exact_mod_cast ha
  change 0 < (a : ℝ) + u * evalIntCoeffs cs u
  linarith [(abs_le.mp hp).1]

theorem frequency_scaled_bound (t : ℝ) (ht : frequencyLower ≤ t ∧ t ≤ frequencyUpper) :
    |20000000000*t - 1105254005| ≤ 1 := by
  rw [abs_le]
  norm_num [frequencyLower,frequencyUpper] at ht
  constructor <;> linarith [ht.1,ht.2]

