def lyapunovSourceParameterRe (t : ℝ) : ℝ :=
  (-)*t^15 + ()*t^14 + ()*t^13 + (-)*t^12 + (-)*t^11 + ()*t^10 + (-)*t^9 + (-)*t^8 + ()*t^7 + ()*t^6 + (-)*t^5 + (-)*t^4 + (-)*t^3 + ()*t^2 + ()*t^1 + ()*t^0

def lyapunovSourceParameterIm (t : ℝ) : ℝ :=
  (-)*t^15 + ()*t^14 + (-)*t^13 + (-)*t^12 + ()*t^11 + ()*t^10 + (-)*t^9 + (-)*t^8 + ()*t^7 + (-)*t^6 + (-)*t^5 + (-)*t^4 + ()*t^3 + ()*t^2 + ()*t^1 + ()*t^0

theorem lyapunovRawLeft_pair (w : ℝ) :
    lyapunovRawLeft (Complex.I*(w:ℂ)) =
      h20Pair w (lyapunovRawLeftReal (w^2)) (lyapunovRawLeftImag (w^2)) := by
  ext i
  fin_cases i <;> apply Complex.ext <;>
    simp [lyapunovRawLeft,h20Pair,lyapunovRawLeftReal,lyapunovRawLeftImag,
      pow_succ,Complex.mul_re,Complex.mul_im]
  all_goals ring

theorem h20Pair_dot (w : ℝ) (x y u v : ReducedState) :
    dotProduct (h20Pair w x y) (h20Pair w u v) =
      ((dotProduct x u-w^2*dotProduct y v : ℝ):ℂ) +
        Complex.I*(w:ℂ)*((dotProduct x v+dotProduct y u : ℝ):ℂ) := by
  apply Complex.ext <;>
    simp [h20Pair,dotProduct,Fin.sum_univ_succ,pow_succ,Complex.mul_re,Complex.mul_im]
  all_goals ring

theorem lyapunovPairing_pair (w : ℝ) :
    lyapunovPairing (Complex.I*(w:ℂ)) =
      (lyapunovPairingRe (w^2):ℂ) +
        Complex.I*(w:ℂ)*(lyapunovPairingIm (w^2):ℂ) := by
  rw [lyapunovPairing,lyapunovRawLeft_pair,h20_q_pair,h20Pair_dot]
  apply Complex.ext <;>
    simp [lyapunovRawLeftReal,lyapunovRawLeftImag,h20QReal,h20QImag,
      lyapunovPairingRe,lyapunovPairingIm,dotProduct,Fin.sum_univ_succ,
      pow_succ,Complex.mul_re,Complex.mul_im]
  all_goals ring_nf
  all_goals simp

def lyapunovContractionRe (r t : ℝ) : ReducedState :=
  hessian r (h20QReal t) (h20RealInt t) +
    t • hessian r (h20QImag t) (h20ImagInt t) -
      (2*h20Scale) • hessian r (h20QReal t) (lyapunovH11 t)

def lyapunovContractionIm (r t : ℝ) : ReducedState :=
  hessian r (h20QReal t) (h20ImagInt t) -
    hessian r (h20QImag t) (h20RealInt t) -
      (2*h20Scale) • hessian r (h20QImag t) (lyapunovH11 t)

def lyapunovSourceRe (r t : ℝ) : ℝ :=
  dotProduct (lyapunovRawLeftReal t) (lyapunovContractionRe r t) -
    t*dotProduct (lyapunovRawLeftImag t) (lyapunovContractionIm r t)

def lyapunovSourceIm (r t : ℝ) : ℝ :=
  dotProduct (lyapunovRawLeftReal t) (lyapunovContractionIm r t) +
    dotProduct (lyapunovRawLeftImag t) (lyapunovContractionRe r t)

theorem lyapunov_source_real_identity (r t : ℝ) :
    even1 t*lyapunovSourceRe r t = lyapunovScalarRe t +
      (even0 t+r*even1 t)*lyapunovSourceParameterRe t := by
  simp [lyapunovSourceRe,lyapunovContractionRe,lyapunovContractionIm,
    lyapunovRawLeftReal,lyapunovRawLeftImag,h20QReal,h20QImag,
    h20RealInt,h20ImagInt,lyapunovH11,h20Scale,even0,even1,
    lyapunovScalarRe,lyapunovSourceParameterRe,
    dotProduct,Fin.sum_univ_succ,hessian,hessianRow,
    speciesVariation,coordinate,binding,inputSpecies,enzymeSpecies]
  ring

theorem lyapunov_source_imag_identity (r t : ℝ) :
    even1 t*lyapunovSourceIm r t = lyapunovScalarIm t +
      (even0 t+r*even1 t)*lyapunovSourceParameterIm t := by
  simp [lyapunovSourceIm,lyapunovContractionRe,lyapunovContractionIm,
    lyapunovRawLeftReal,lyapunovRawLeftImag,h20QReal,h20QImag,
    h20RealInt,h20ImagInt,lyapunovH11,h20Scale,even0,even1,
    lyapunovScalarIm,lyapunovSourceParameterIm,
    dotProduct,Fin.sum_univ_succ,hessian,hessianRow,
    speciesVariation,coordinate,binding,inputSpecies,enzymeSpecies]
  ring

theorem h20Pair_conjugate (w : ℝ) (x y : ReducedState) :
    (fun i => star (h20Pair w x y i)) =
      (fun i => (x i:ℂ)) + (-Complex.I*(w:ℂ)) • (fun i => (y i:ℂ)) := by
  ext i
  apply Complex.ext <;> simp [h20Pair,Complex.mul_re,Complex.mul_im]

theorem h20Pair_conjugate_hessian (r w : ℝ) (x y u v : ReducedState) :
    complexHessian r (fun i => star (h20Pair w x y i)) (h20Pair w u v) =
      h20Pair w (hessian r x u+w^2 • hessian r y v)
        (hessian r x v-hessian r y u) := by
  rw [h20Pair_conjugate]
  simp only [h20Pair,complexHessian_add_left,complexHessian_add_right,
    complexHessian_smul_left,complexHessian_smul_right,complexHessian_ofReal]
  ext i
  apply Complex.ext <;> simp [pow_succ,Complex.mul_re,Complex.mul_im]
  all_goals ring

theorem h20Pair_hessian_ofReal (r w : ℝ) (x y u : ReducedState) :
    complexHessian r (h20Pair w x y) (fun i => (u i:ℂ)) =
      h20Pair w (hessian r x u) (hessian r y u) := by
  simp only [h20Pair,complexHessian_add_left,complexHessian_smul_left,
    complexHessian_ofReal]

theorem h20Pair_sub_real_smul (w c : ℝ) (x y u v : ReducedState) :
    h20Pair w x y - (c:ℂ) • h20Pair w u v =
      h20Pair w (x-c • u) (y-c • v) := by
  ext i
  simp [h20Pair]
  ring

def lyapunovScaledContraction (r w : ℝ) : Fin 9 → ℂ :=
  complexHessian r (fun i => star (adjugateVector (Complex.I*(w:ℂ)) i))
      (scaledH20 w) -
    ((2*h20Scale:ℝ):ℂ) • complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
      (fun i => (lyapunovH11 (w^2) i:ℂ))

theorem lyapunovScaledContraction_pair (r w : ℝ) :
    lyapunovScaledContraction r w =
      h20Pair w (lyapunovContractionRe r (w^2)) (lyapunovContractionIm r (w^2)) := by
  have hh : scaledH20 w = h20Pair w (h20RealInt (w^2)) (h20ImagInt (w^2)) := by
    ext i
    simp [scaledH20,h20Pair]
  rw [lyapunovScaledContraction,hh,h20_q_pair,
    h20Pair_conjugate_hessian,h20Pair_hessian_ofReal,h20Pair_sub_real_smul]
  rfl

theorem lyapunovScaledContraction_scalar (r w : ℝ)
    (hp : even0 (w^2)+r*even1 (w^2)=0) :
    (even1 (w^2):ℂ)*dotProduct (lyapunovRawLeft (Complex.I*(w:ℂ)))
      (lyapunovScaledContraction r w) =
    (lyapunovScalarRe (w^2):ℂ) + Complex.I*(w:ℂ)*(lyapunovScalarIm (w^2):ℂ) := by
  have hr : even1 (w^2)*lyapunovSourceRe r (w^2) = lyapunovScalarRe (w^2) := by
    have h := lyapunov_source_real_identity r (w^2)
    rw [hp,zero_mul,add_zero] at h
    exact h
  have hi : even1 (w^2)*lyapunovSourceIm r (w^2) = lyapunovScalarIm (w^2) := by
    have h := lyapunov_source_imag_identity r (w^2)
    rw [hp,zero_mul,add_zero] at h
    exact h
  rw [lyapunovRawLeft_pair,lyapunovScaledContraction_pair,h20Pair_dot]
  change (even1 (w^2):ℂ)*((lyapunovSourceRe r (w^2):ℂ) +
    Complex.I*(w:ℂ)*(lyapunovSourceIm r (w^2):ℂ)) = _
  apply Complex.ext <;> simp [Complex.mul_re,Complex.mul_im]
  · exact hr
  · linear_combination w*hi

/-- The same source coefficient used in the quadratic Hopf branch balance,
with the explicit normalized left functional and actual resolvent vectors. -/
def explicitSourceCoefficient (r w : ℝ) : ℂ :=
  -2*lyapunovLeft (Complex.I*(w:ℂ))
      (complexHessian r (adjugateVector (Complex.I*(w:ℂ)))
        (fun i => (lyapunovH11 (w^2) i:ℂ))) +
    lyapunovLeft (Complex.I*(w:ℂ))
      (complexHessian r (fun i => star (adjugateVector (Complex.I*(w:ℂ)) i))
        (h20Pilot w))

theorem explicitSourceCoefficient_scaled (r w : ℝ)
    (hn : lyapunovPairing (Complex.I*(w:ℂ)) ≠ 0) :
    (h20Scale:ℂ)*lyapunovPairing (Complex.I*(w:ℂ))*explicitSourceCoefficient r w =
      dotProduct (lyapunovRawLeft (Complex.I*(w:ℂ))) (lyapunovScaledContraction r w) := by
  have hk : (h20Scale:ℂ) ≠ 0 := by exact_mod_cast ne_of_gt h20Scale_pos
  simp only [explicitSourceCoefficient,lyapunovLeft_apply,h20Pilot,
    complexHessian_smul_right,lyapunovScaledContraction,dotProduct_sub,dotProduct_smul,
    smul_eq_mul]
  push_cast
  field_simp [hn,hk]
  ring

theorem explicitSourceCoefficient_complex_identity (r w : ℝ)
    (hp : even0 (w^2)+r*even1 (w^2)=0)
    (hn : lyapunovPairing (Complex.I*(w:ℂ)) ≠ 0) :
    (even1 (w^2):ℂ)*((h20Scale:ℂ)*lyapunovPairing (Complex.I*(w:ℂ))*
      explicitSourceCoefficient r w) =
    (lyapunovScalarRe (w^2):ℂ) + Complex.I*(w:ℂ)*(lyapunovScalarIm (w^2):ℂ) := by
  rw [explicitSourceCoefficient_scaled r w hn]
  exact lyapunovScaledContraction_scalar r w hp

theorem lyapunovDirectDenominator_ne_zero (w : ℝ) (he : even1 (w^2) ≠ 0)
    (hn : lyapunovPairing (Complex.I*(w:ℂ)) ≠ 0) :
    lyapunovDirectDenominator (w^2) ≠ 0 := by
  have hz : Complex.normSq (lyapunovPairing (Complex.I*(w:ℂ))) ≠ 0 :=
    fun h => hn (Complex.normSq_eq_zero.mp h)
  have hh : Complex.normSq (lyapunovPairing (Complex.I*(w:ℂ))) =
      lyapunovPairingRe (w^2)^2 + w^2*lyapunovPairingIm (w^2)^2 := by
    rw [lyapunovPairing_pair]
    simp [Complex.normSq_apply,Complex.mul_re,Complex.mul_im]
    ring
  rw [hh] at hz
  exact mul_ne_zero (mul_ne_zero (ne_of_gt h20Scale_pos) he) hz

theorem explicitSourceCoefficient_real_product (r w : ℝ)
    (hp : even0 (w^2)+r*even1 (w^2)=0)
    (hn : lyapunovPairing (Complex.I*(w:ℂ)) ≠ 0) :
    lyapunovDirectDenominator (w^2)*(explicitSourceCoefficient r w).re =
      lyapunovDirectNumerator (w^2) := by
  have h := explicitSourceCoefficient_complex_identity r w hp hn
  rw [lyapunovPairing_pair] at h
  have hr := congrArg Complex.re h
  have hi := congrArg Complex.im h
  simp only [Complex.mul_re,Complex.mul_im,Complex.add_re,Complex.add_im,
    Complex.ofReal_re,Complex.ofReal_im,Complex.I_re,Complex.I_im] at hr hi
  dsimp only [lyapunovDirectDenominator,lyapunovDirectNumerator]
  linear_combination lyapunovPairingRe (w^2)*hr + w*lyapunovPairingIm (w^2)*hi

theorem explicitSourceCoefficient_real_eq (r w : ℝ)
    (hf : frequencyPolynomial (w^2)=0)
    (hp : even0 (w^2)+r*even1 (w^2)=0)
    (he : even1 (w^2) ≠ 0)
    (hn : lyapunovPairing (Complex.I*(w:ℂ)) ≠ 0)
    (hd : lyapunovDenominator (w^2) ≠ 0) :
    (explicitSourceCoefficient r w).re =
      lyapunovNumerator (w^2)/lyapunovDenominator (w^2) := by
  have hc := lyapunov_scalar_cross_identity (w^2)
  have hx : lyapunovDirectNumerator (w^2)*lyapunovDenominator (w^2) =
      lyapunovDirectDenominator (w^2)*lyapunovNumerator (w^2) :=
    sub_eq_zero.mp (by simpa [hf] using hc)
  apply (eq_div_iff hd).mpr
  apply mul_left_cancel₀ (lyapunovDirectDenominator_ne_zero w he hn)
  calc
    lyapunovDirectDenominator (w^2)*
        ((explicitSourceCoefficient r w).re*lyapunovDenominator (w^2)) =
      (lyapunovDirectDenominator (w^2)*(explicitSourceCoefficient r w).re)*
        lyapunovDenominator (w^2) := by ring
    _ = lyapunovDirectNumerator (w^2)*lyapunovDenominator (w^2) := by
      rw [explicitSourceCoefficient_real_product r w hp hn]
    _ = _ := hx

theorem explicitSourceCoefficient_real_negative (r w : ℝ) (hw : w ≠ 0)
    (hc : candidatePolynomial r (Complex.I*(w:ℂ))=0)
    (ht : frequencyLower ≤ w^2 ∧ w^2 ≤ frequencyUpper) :
    (explicitSourceCoefficient r w).re < 0 := by
  obtain ⟨hp,ho⟩ := frequency_equations_of_root r w hw hc
  have hf : frequencyPolynomial (w^2)=0 := by
    rw [frequency_elimination_identity]
    linear_combination even1 (w^2)*ho-odd1 (w^2)*hp
  have he := ne_of_lt (frequency_even_signs (w^2) ht).2
  have hn := lyapunovPairing_critical_ne_zero r w hw hc
  have hd := lyapunovDenominator_positive (w^2) ht
  rw [explicitSourceCoefficient_real_eq r w hf hp he hn (ne_of_gt hd)]
  exact div_neg_of_neg_of_pos (lyapunovNumerator_negative (w^2) ht) hd

end
end ThreeSitePhosphorylation.AttractingWitness
